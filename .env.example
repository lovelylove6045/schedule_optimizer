# Postgres (used by docker-compose and by backend/app/config.py)
POSTGRES_DB=schedule_optimizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
CORS_ALLOW_ORIGINS=http://localhost:5173
# Local development also accepts localhost and private-LAN IPs on port 5173.
# Set this to an empty value to disable the regex or replace it for another setup.
CORS_ALLOW_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}):5173$

# Frontend
VITE_API_BASE_URL=http://localhost:8000
